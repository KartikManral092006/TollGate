NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://tollgate:tollgate@localhost:5436/tollgate
# Production (Neon): DATABASE_URL is the pooled string, DIRECT_URL the direct one (migrations).
DIRECT_URL=
REDIS_URL=redis://localhost:6381
NEXT_PUBLIC_APP_URL=http://localhost:3001

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_IP_HEADER=
AUTH_TRUSTED_PROXIES=

EMAIL_API_KEY=
EMAIL_FROM=
# Public contact for privacy and support requests (shown on /privacy and /terms).
CONTACT_EMAIL=

# A NEW Nexconn app for Tollgate. Never reuse Margin's App Key or App Secret.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_AREA=SG
NEXCONN_DEV_ROUTES=0

# Call SDK. Billing starts when a call is created; keep calls off until T7 confirms $0.
CALLS_ENABLED=0
CALL_MINUTES_PER_TEAM_DAY=60

# Optional server-wide default for "Why?" (Anthropic). Teams can bring their own provider.
AI_API_KEY=
# Required for teams to save their own AI keys (encrypted at rest): openssl rand -base64 32
AI_KEYS_SECRET=
