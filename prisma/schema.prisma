generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Preview since 7.4.0: lets @@unique take `where`. Re-test on any Prisma upgrade.
  // relationJoins: nested includes load in one SQL query (LATERAL joins) instead of one query
  // per relation level. A room refresh went from ~31 queries to a handful. Still preview in
  // 7.10.1; covered by the integration tests against real Postgres.
  previewFeatures = ["partialIndexes", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Auth tables follow Better Auth 1.7.15's core schema. The Prisma adapter reaches them as
// prisma.user, prisma.session, ... and checks them at runtime, so keep these models and the
// additionalFields in features/auth/server/auth.ts in step.

model User {
  id            String    @id // set in the user.create.before hook: 32 letters and digits
  name          String // "" for magic-link sign-ups until a profile step exists
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  nexconnUserId String?   @unique // equals id; written in the same INSERT
  language      String    @default("en")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  teamsCreated   Team[]
  memberships    Membership[]     @relation("MembershipUser")
  invited        Membership[]     @relation("MembershipInviter")
  invitesCreated Invite[]
  hookTokens     HookToken[]
  gatesRequested Gate[]           @relation("GateRequester")
  gatesReviewed  Gate[]           @relation("GateReviewer")
  policyRules    PolicyRule[]
  windowsFor     ApprovalWindow[] @relation("WindowRequester")
  windowsOpened  ApprovalWindow[] @relation("WindowCreator")
  windowsEnded   ApprovalWindow[] @relation("WindowEnder")
  votes          Vote[]
  gatesSeen      GateSeen[]
  callsStarted   CallSession[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum TeamRole {
  owner
  approver
  requester
  guest
}

enum GateMode {
  guard
  delegate
}

enum GateStatus {
  pending
  approved
  denied
  parked
  expired
  bypassed // ran without the team: someone started Claude Code with TOLLGATE_BYPASS=1
}

enum VoteDecision {
  approve
  deny
}

enum CallKind {
  huddle
  ring
}

enum AiProvider {
  builtin
  anthropic
  openai_compatible
}

// What a team rule does to a matching non-production gate.
enum PolicyAction {
  one_approval // quorum 1 instead of the preset's
  auto_approve // approved on arrival, recorded with the rule
}

enum CallStatus {
  permitted
  live
  ended
  failed
}

// A group of people with one Nexconn group channel (the thread space).
model Team {
  id                  String           @id // 32 letters and digits (lib/ids)
  name                String
  nexconnChannelId    String           @unique // "tg" + id
  nexconnGroupReadyAt DateTime? // set once the Nexconn group exists
  nextGateCode        Int              @default(1) // TG-n; taken in the gate-create transaction
  // Approvers see the developer's last instruction to the agent and its last few steps (CLI 0.3+).
  shareAgentTask      Boolean          @default(false)
  // Freeze or incident mode (features/teams/shared/freeze.ts): on while freezeUntil is ahead.
  freezeKind          String? // incident | freeze
  freezeReason        String?          @db.VarChar(200)
  freezeUntil         DateTime?
  freezeStartedAt     DateTime?
  freezeById          String?
  createdById         String?
  createdBy           User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  memberships         Membership[]
  invites             Invite[]
  repos               RepoLink[]
  gates               Gate[]
  calls               CallSession[]
  windows             ApprovalWindow[]
  aiConfig            TeamAiConfig?
  agentSessions       AgentSession[]

  @@map("teams")
}

model Membership {
  teamId          String
  userId          String
  role            TeamRole  @default(approver)
  joinedAt        DateTime  @default(now())
  nexconnJoinedAt DateTime? // set once the user is in the team's Nexconn group
  invitedById     String? // whose invite link they joined through (shown in Members)
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User      @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy       User?     @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@id([teamId, userId])
  @@index([userId, joinedAt(sort: Desc)])
  @@map("memberships")
}

// Invite links. Only the sha256 of the token is stored; the link is shown once.
model Invite {
  id          String    @id
  teamId      String
  tokenHash   String    @unique
  role        TeamRole  @default(approver) // approver | guest
  createdById String?
  gateId      String? // made to get this gate decided: single use, 48 h
  maxUses     Int       @default(10)
  uses        Int       @default(0) // changed only in the accept transaction
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  gate        Gate?     @relation(fields: [gateId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("invites")
}

model RepoLink {
  id                   String           @id
  teamId               String
  name                 String // e.g. "acme/billing"
  mode                 GateMode         @default(guard)
  presets              Json // server-authoritative presets, including quorum (features/gates/shared/presets)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  team                 Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tokens               HookToken[]
  gates                Gate[]
  rules                PolicyRule[]
  windows              ApprovalWindow[]
  // Suggestions the owner said no to ("preset:env:action"), so they aren't offered again.
  dismissedSuggestions String[]         @default([])

  @@unique([teamId, name])
  @@map("repo_links")
}

// A hook token can create gates and read its own repo's gates. It can never vote.
model HookToken {
  id          String    @id
  repoId      String
  tokenHash   String    @unique // sha256; the plaintext is shown once at init
  prefix      String // first characters, so people can tell tokens apart
  createdById String // the requester for gates raised with this token
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  repo        RepoLink  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@map("hook_tokens")
}

// One proposed risky command. Postgres is the truth; Nexconn metadata mirrors it.
model Gate {
  id            String           @id
  code          Int // TG-17 (per-team sequence)
  teamId        String
  repoId        String
  requesterId   String
  preset        String
  tool          String           @default("bash") // bash | edit | mcp: a command, a file edit or an MCP call
  env           String // prod | staging | other
  command       String // redacted: the command, "edit <path>" or "mcp__server__tool {args}"
  cwd           String // redacted
  branch        String?
  context       String           @db.VarChar(2048) // redacted, truncated
  // Raised while the team was frozen: no rules or windows, stricter production quorum.
  frozen        Boolean          @default(false)
  preview       String?          @db.VarChar(2000) // what it will do, from read-only checks on the developer's machine (CLI 0.3+); redacted
  intent        String?          @db.VarChar(300) // the agent's own description of the command; redacted
  via           String?          @db.VarChar(1400) // "pnpm db:deploy → prisma migrate deploy" lines; redacted
  sessionId     String?          @db.VarChar(200) // Claude Code session, for grouping a run's gates later
  task          String?          @db.VarChar(500) // the developer's last instruction to the agent; redacted, opt-in
  steps         String?          @db.VarChar(1000) // the agent's last few calls before this one, one per line; redacted
  redactions    Int
  cmdHash       String // sha256(command + cwd + repo), from the hook; binds the grant
  quorum        Int
  status        GateStatus       @default(pending)
  decidedAt     DateTime?
  decidedById   String?
  denyReason    String?
  parksAt       DateTime? // when the waiting hook gives up and parks it (countdown on the card)
  parkedAt      DateTime?
  remindedAt    DateTime? // the one "still parked" reminder went out
  question      String?          @db.VarChar(500) // set when an approver asked instead of deciding
  followUpOfId  String? // the asked gate this retry answers
  policyRuleId  String? // approved on arrival by this team rule
  messageId     String? // Nexconn message for metadata updates
  // What happened when the approved call ran, reported by the CLI's PostToolUse hooks (0.3+).
  outcome       String? // succeeded | failed | interrupted
  outcomeAt     DateTime?
  exitCode      Int? // from "Exit code N" on a failed Bash call
  durationMs    Int?
  output        String?          @db.VarChar(1000) // the output's tail; redacted
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repo          RepoLink         @relation(fields: [repoId], references: [id], onDelete: Cascade)
  requester     User             @relation("GateRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  // A bypassed gate's after-the-fact review: someone on the team looked at what ran.
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?          @db.VarChar(500)
  reviewedBy    User?            @relation("GateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  votes         Vote[]
  invites       Invite[]
  seen          GateSeen[]
  grant         Grant?
  calls         CallSession[]
  followUpOf    Gate?            @relation("GateFollowUp", fields: [followUpOfId], references: [id], onDelete: SetNull)
  followUps     Gate[]           @relation("GateFollowUp")
  policyRule    PolicyRule?      @relation(fields: [policyRuleId], references: [id], onDelete: SetNull)
  windowId      String? // approved on arrival by this approval window
  window        ApprovalWindow?  @relation("WindowApproved", fields: [windowId], references: [id], onDelete: SetNull)
  windowsOpened ApprovalWindow[] @relation("WindowSource")

  @@unique([teamId, code])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([repoId, cmdHash])
  @@index([teamId, sessionId])
  @@index([followUpOfId])
  // The per-minute sweep: expire and remind parked gates without scanning every gate.
  @@index([status, parkedAt])
  // A person's profile: the gates their agent raised, newest first.
  @@index([requesterId, createdAt(sort: Desc)])
  @@map("gates")
}

// One decision per person per gate, written in the same transaction as the quorum check.
model Vote {
  gateId    String
  userId    String
  decision  VoteDecision
  reason    String?
  createdAt DateTime     @default(now())
  gate      Gate         @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gateId, userId])
  @@index([userId])
  @@map("votes")
}

// A parked gate approved later. Single use, bound to cmdHash, expires after 24 h.
model Grant {
  id        String    @id
  gateId    String    @unique
  repoId    String
  cmdHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  gate      Gate      @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([repoId, cmdHash])
  @@map("grants")
}

// A Call SDK call (huddle or ring). The row exists from the permit; callId arrives once the
// browser's startCall succeeds. At most one open huddle per gate: permits are issued in a
// transaction that holds the gate's row lock (features/call/server/permits.ts).
model CallSession {
  id           String     @id // permit id
  callId       String?    @unique // Nexconn callId (= room id)
  teamId       String
  gateId       String?
  kind         CallKind
  startedById  String
  calleeIds    String[]
  status       CallStatus @default(permitted)
  maxSec       Int        @default(900)
  startedAt    DateTime?
  endedAt      DateTime?
  durationSec  Int?
  participants String[]   @default([])
  messageId    String? // TG:Huddle card
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gate         Gate?      @relation(fields: [gateId], references: [id], onDelete: Cascade)
  startedBy    User       @relation(fields: [startedById], references: [id], onDelete: Cascade)

  @@index([gateId, status])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@map("call_sessions")
}

// The AI provider a team uses for "Why?" explanations. The API key is encrypted with
// AI_KEYS_SECRET (lib/crypto-box.ts) and never leaves the server; only its last 4 characters
// are shown. No row (or provider "builtin") means rule-based explanations.
model TeamAiConfig {
  teamId       String     @id
  provider     AiProvider @default(builtin)
  label        String? // the preset the owner picked, e.g. "NVIDIA NIM"
  baseUrl      String? // https, public (lib/safe-url.ts)
  model        String?
  apiKeySealed String?
  apiKeyLast4  String?
  updatedById  String?
  updatedAt    DateTime   @updatedAt
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_ai_configs")
}

// A rule an owner accepted from Tollgate's suggestions: never for production.
// "Approve the same for 2 hours": while it's open, one person's agent gets this kind of gate
// (repo + preset + env) approved on arrival. Opened by an approver from a gate they approved;
// anyone who can approve may end it early.
model ApprovalWindow {
  id          String    @id
  teamId      String
  repoId      String
  preset      String
  env         String // staging | other: never prod
  requesterId String // whose agent it covers
  createdById String
  gateId      String // the approved gate it was opened from
  expiresAt   DateTime
  endedAt     DateTime?
  endedById   String?
  createdAt   DateTime  @default(now())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  repo        RepoLink  @relation(fields: [repoId], references: [id], onDelete: Cascade)
  requester   User      @relation("WindowRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("WindowCreator", fields: [createdById], references: [id], onDelete: Cascade)
  endedBy     User?     @relation("WindowEnder", fields: [endedById], references: [id], onDelete: SetNull)
  gate        Gate      @relation("WindowSource", fields: [gateId], references: [id], onDelete: Cascade)
  approved    Gate[]    @relation("WindowApproved")

  @@index([repoId, preset, env, requesterId, expiresAt])
  @@index([teamId, expiresAt])
  @@map("approval_windows")
}

model PolicyRule {
  id          String       @id
  repoId      String
  preset      String
  env         String // staging | other
  action      PolicyAction
  createdById String?
  createdAt   DateTime     @default(now())
  repo        RepoLink     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  gates       Gate[]

  @@unique([repoId, preset, env])
  @@map("policy_rules")
}

// One Claude Code session that raised gates in a team, shown as one TG:Agent card the bot
// keeps up to date. Gates join it on (teamId, sessionId); the counts are read from them.
model AgentSession {
  id          String   @id
  teamId      String
  sessionId   String   @db.VarChar(200) // Claude Code's session id, as the hook sent it
  repoId      String
  requesterId String
  messageId   String? // the TG:Agent card, for metadata updates
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, sessionId])
  @@map("agent_sessions")
}

// Who has looked at a gate's card (not the requester). "Seen by" on the card, and which
// parked gates nobody saw. Native read receipts can't do this: only a message's sender may
// read them, and the bot that posts cards never connects.
model GateSeen {
  gateId String
  userId String
  seenAt DateTime @default(now())
  gate   Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gateId, userId])
  @@index([userId])
  @@map("gate_seen")
}
