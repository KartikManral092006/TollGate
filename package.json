{
  "name": "tollgate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && next dev -H localhost -p 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "cli:build": "node packages/cli/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "2.1.2",
    "@nexconn/call": "26.2.1",
    "@nexconn/chat": "26.2.1",
    "@nexconn/chatui": "26.2.5",
    "@nexconn/engine": "26.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@shadcn/react": "^0.3.1",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "gsap": "3.15.0",
    "ioredis": "^6.0.0",
    "lenis": "1.3.26",
    "lit": "^3.3.3",
    "lucide-react": "^1.66.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "three": "0.187.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "dotenv": "^18.0.9",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  }
}
